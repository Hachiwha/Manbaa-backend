# FlowForge backend Docker environment template.
# Copy to .env for Docker Compose and replace every change-me value.

NODE_ENV=development
PORT=3000
NESTJS_PORT=3000
ENABLE_SWAGGER=true
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001
DEV_BYPASS_AUTH=false
THROTTLE_TTL=60
THROTTLE_LIMIT=120

APP_DB_NAME=appdb
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app-db-password
APP_DB_PORT=5432
DATABASE_URL=postgres://app:change-me-app-db-password@postgres:5432/appdb
MIGRATION_DATABASE_URL=postgres://app:change-me-app-db-password@postgres:5432/appdb

NATS_URL=nats://nats:4222
NATS_STREAM_NAME=FLOWFORGE
NATS_PORT=4222
NATS_MONITOR_PORT=8222

REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_KEY_PREFIX=platform:

JWT_ACCESS_SECRET=replace-me-with-at-least-32-chars-access
JWT_REFRESH_SECRET=replace-me-with-at-least-32-chars-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

INTERNAL_AUTH_SECRET=replace-me-with-at-least-32-chars-internal
INTERNAL_AUTH_PREVIOUS_SECRET=
INTERNAL_AUTH_ISSUER=nestjs-platform
INTERNAL_AUTH_AUDIENCE=fastapi-workers
INTERNAL_AUTH_ALLOWED_SERVICES=ai-orchestrator,document-worker,research-worker,media-worker,export-worker
INTERNAL_AUTH_TOKEN_TTL_SECONDS=300

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET_NAME=documents
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_SOURCES=workspace-sources
MINIO_BUCKET_PREVIEWS=workspace-previews
MINIO_BUCKET_ASSETS=workspace-assets
MINIO_BUCKET_WORKSPACE_EXPORTS=workspace-exports
MINIO_BUCKET_SNAPSHOTS=workspace-snapshots
MINIO_BUCKET_TEMP=workspace-temp

FASTAPI_ENABLED=false
FASTAPI_PORT=8000
FASTAPI_HEALTH_URL=http://ai-service:8000/health
FASTAPI_INTERNAL_URL=http://ai-service:8000/internal

OLLAMA_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_LLM_MODEL=mistral:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

ELSA_ENABLED=false
ELSA_HEALTH_URL=http://elsa-server:8080/health

NESTJS_CONTEXT=.
NESTJS_DOCKERFILE=Dockerfile
FASTAPI_CONTEXT=./ai-service
NEXTJS_CONTEXT=./frontend
NEXTJS_PORT=3001

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_ELSA_URL=http://localhost:5000
