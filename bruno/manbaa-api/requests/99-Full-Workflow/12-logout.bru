meta {
  name: 12 - Logout
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/auth/logout
}

headers {
  Content-Type: application/json
}

body {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 204
}

script.post-response {
  bru.setEnvVar('accessToken', '');
  bru.setEnvVar('refreshToken', '');
}
