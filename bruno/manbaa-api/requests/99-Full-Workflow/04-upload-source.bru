meta {
  name: 04 - Upload Source
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/workspaces/{{workspaceId}}/sources
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:multipart {
  file: @file(../fixtures/brand-guide.md)
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script.post-response {
  if (res.body.id) {
    bru.setEnvVar('sourceId', res.body.id);
  }
}
