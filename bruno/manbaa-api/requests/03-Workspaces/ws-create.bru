meta {
  name: Create Workspace
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/workspaces?organizationId={{organizationId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body {
  {
    "name": "Manbaa Dev Workspace",
    "description": "Primary workspace for Bruno API testing"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.name: eq "Manbaa Dev Workspace"
}

script.post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar('workspaceId', res.body.id);
  }
}
