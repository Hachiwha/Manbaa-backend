meta {
  name: 400 Blank AI Prompt
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/workspaces/{{workspaceId}}/ai/tasks
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body {
  {
    "taskType": "generate_component",
    "payload": {
      "prompt": ""
    }
  }
}

assert {
  res.status: eq 400
}
