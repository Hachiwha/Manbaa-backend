meta {
  name: Create Canvas Object
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/workflows/{{workflowId}}/canvas/objects
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body {
  {
    "type": "heading",
    "label": "Hisn",
    "position_x": 100,
    "position_y": 100,
    "width": 300,
    "height": 60,
    "properties": {
      "level": 1,
      "text": "Hisn"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}
