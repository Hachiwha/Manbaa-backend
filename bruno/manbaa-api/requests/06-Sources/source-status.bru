meta {
  name: Source Status
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/workspaces/{{workspaceId}}/sources/{{sourceId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{sourceId}}
  res.body.status: isDefined
}
