meta {
  name: Create Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/sessions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "name": "Test Session"
  }
}

assert {
  res.status: eq 201
  res.body.data.id: isPresent
}
