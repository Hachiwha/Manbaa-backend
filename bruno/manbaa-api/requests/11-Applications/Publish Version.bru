meta {
  name: Publish Version
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/applications/{{applicationId}}/publish
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "versionId": "{{versionId}}"
  }
}

assert {
  res.status: eq 201
}
