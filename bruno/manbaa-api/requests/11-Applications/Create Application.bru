meta {
  name: Create Application
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/applications
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Test Application"
  }
}

assert {
  res.status: eq 201
  res.body.data.id: isPresent
}
