meta {
  name: Get Suggestion
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/workspaces/{{workspaceId}}/canvases/{{canvasId}}/suggestions/{{suggestionId}}
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{suggestionId}}
}
