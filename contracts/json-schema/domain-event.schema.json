{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp.local/schemas/domain-event.schema.json",
  "title": "DomainEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "organizationId", "userId", "correlationId", "timestamp", "payload"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "stateVersion": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
